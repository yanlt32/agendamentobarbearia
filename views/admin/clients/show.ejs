<%- include('../../partials/admin-head') %>

<div class="row g-3 mb-4">
  <div class="col-lg-4">
    <div class="panel text-center">
      <div class="barber-photo mx-auto mb-3"><i class="fa-solid fa-user"></i></div>
      <h5 class="mb-1"><%= record.name %></h5>
      <p class="text-secondary small mb-3"><%= record.phone %><% if (record.email) { %> &bull; <%= record.email %><% } %></p>
      <% if (record.blacklisted) { %>
        <p class="mb-3"><span class="status-badge status-cancelled"><i class="fa-solid fa-ban me-1"></i>Bloqueado (nao compareceu)</span></p>
      <% } %>
      <div class="d-flex justify-content-around mb-3">
        <div><h4 class="gold-text mb-0"><%= record.visits_count %></h4><small class="text-secondary">Visitas</small></div>
        <div><h6 class="mb-0"><%= record.last_visit || '-' %></h6><small class="text-secondary">Ultimo atendimento</small></div>
      </div>
      <% if (record.notes) { %><p class="small text-secondary text-start"><strong>Obs:</strong> <%= record.notes %></p><% } %>
      <a href="/admin/clients/<%= record.id %>/edit" class="btn btn-gold btn-sm w-100 mt-2">Editar cadastro</a>
      <% if (record.blacklisted) { %>
        <form action="/admin/clients/<%= record.id %>/unblacklist" method="POST" class="mt-2">
          <button type="submit" class="btn btn-outline-light btn-sm w-100"><i class="fa-solid fa-lock-open me-1"></i>Liberar para agendar online</button>
        </form>
      <% } %>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="panel">
      <h6 class="panel-title">Historico de atendimentos</h6>
      <div class="table-responsive">
        <table class="table table-admin align-middle">
          <thead><tr><th>Data</th><th>Hora</th><th>Servico</th><th>Barbeiro</th><th>Valor</th><th>Status</th></tr></thead>
          <tbody>
            <% history.forEach(function(h) { %>
              <tr>
                <td><%= h.date %></td>
                <td><%= h.time %></td>
                <td><%= h.service_name %></td>
                <td><%= h.barber_name %></td>
                <td>R$ <%= h.price.toFixed(2).replace('.', ',') %></td>
                <td><span class="status-badge status-<%= h.status %>"><%= ({pending:'Pendente',confirmed:'Confirmado',completed:'Finalizado',cancelled:'Cancelado',no_show:'Nao compareceu'})[h.status] %></span></td>
              </tr>
            <% }) %>
            <% if (history.length === 0) { %>
              <tr><td colspan="6" class="text-center text-secondary py-4">Nenhum atendimento registrado.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/admin-footer') %>
